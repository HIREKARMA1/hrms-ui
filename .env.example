# HireKarma HRMS frontend - environment template
# Copy to .env and adjust for your environment:
#   cp .env.example .env

# Backend API base URL, including the global prefix (API_PREFIX on the server).
API_BASE_URL=http://localhost:3000/api/v1

# Upload employee profile photos via POST /uploads into folder `employees/photos`.
# Set to true so registration/profile photo saves return a real asset URL for photoUrl.
VITE_EMPLOYEE_PHOTO_UPLOAD_ENABLED=true
